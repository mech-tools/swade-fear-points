<div class="swade-official fear-points-display">
    {{#if isGm}}
        <button class="fear-minus-button" data-action="decrementFearPoint">
            <i class="minus-button fa-regular fa-minus"></i>
        </button>
    {{/if}}
    <div class="count">{{fearPoints}}</div>
    {{#if isGm}}
        <button class="fear-plus-button" data-action="incrementFearPoint">
            <i class="plus-button fa-regular fa-plus"></i>
        </button>
    {{/if}}
</div>